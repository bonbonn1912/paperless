# Server & Reverse Proxy
DOMAIN=paperless.dominikw.de
PAPERLESS_HOST_BIND=127.0.0.1
PAPERLESS_PORT=8088
PAPERLESS_DATA_DIR=./data

# Container images (built and pushed via GitHub Actions GHCR)
IMAGE_BACKEND=ghcr.io/bonbonn1912/paperless-backend:latest
IMAGE_FRONTEND=ghcr.io/bonbonn1912/paperless-frontend:latest

# Application
APP_ENV=production
DATA_DIR=/data
DATABASE_URL=sqlite:////data/database/app.sqlite3
MAX_UPLOAD_MB=100
MAX_BATCH_FILES=100
UPLOAD_CONCURRENCY=2
STATUS_MAX_ITEMS=500
MAX_CAPTURE_PAGES=100
MAX_CAPTURE_TOTAL_MB=1024
MAX_ASSEMBLED_PDF_MB=1024
CAPTURE_DRAFT_TTL_DAYS=7
MAX_PDF_PAGES=300
MAX_IMAGE_PIXELS=40000000
HEAVY_JOB_CONCURRENCY=1
HEAVY_CPU_LIMIT=2
HEAVY_MEMORY_MB=3072
OCR_PAGE_TIMEOUT_SECONDS=90
# Admin Authentication
# Option 1 (Empfohlen): Einfaches Passwort angeben - die App generiert den Argon2id-Hash automatisch!
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# Option 2: Manueller Hash (nur nötig falls mehrere Benutzer oder falls ADMIN_PASSWORD nicht gesetzt ist)
# APP_USERS_JSON={"admin":"$$argon2id$$v=19$$m=65536,t=3,p=4$$Fy29plb68Zwy7Mt7TySA6g$$VFIgxAUKS2E24O28/A4gMJ8nUCWmof+o/xIYWiqPYq0"}

SECRET_KEY=change-this-to-a-random-secret-key-in-production

# AI / Ollama LLM Classification (qwen3.5:2b-q4_K_M, 8k Kontext, 3m Keep-Alive)
OLLAMA_ENABLED=true
# Lokal auf macOS außerhalb Docker: http://localhost:11434
# In Docker Compose auf dem Server: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
OLLAMA_KEEP_ALIVE=3m
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_TIMEOUT_SECONDS=90

